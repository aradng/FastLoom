package $package

manifest_routes(access) := {[r.method, r.path] |
	some r in data.app_routes
	r.access == access
}

guarded_accesses := {r.access |
	some r in data.app_routes
	r.access != "open"
}

test_every_guarded_route_has_a_rule_for_its_access if {
	missing := {[access, route] |
		some access in guarded_accesses
		some route in manifest_routes(access)
		not route in object.get(ruled_routes, access, set())
	}
	print("guarded routes with no rule for their access:", missing)
	count(missing) == 0
}

test_no_role_route_is_ruled_open_to_every_user if {
	leaked := {[access, route] |
		some access in guarded_accesses
		access != "user"
		some route in manifest_routes(access)
		route in object.get(ruled_routes, "user", set())
	}
	print("role routes ruled open to every user:", leaked)
	count(leaked) == 0
}

test_every_rule_names_a_route_the_app_guards_that_way if {
	stale := {[access, route] |
		some access, routes in ruled_routes
		some route in routes
		not route in manifest_routes(access)
	}
	print("rules for routes the app no longer guards that way:", stale)
	count(stale) == 0
}
